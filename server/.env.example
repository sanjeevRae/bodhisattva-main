# Bodhisattva API — local development environment.
#
# Copy to `.env` in this directory and fill in real local values:
#   cp .env.example .env
#
# `.env` is never committed. Production values come from the cPanel Node.js
# app configuration, never from a file in the repo (DEPLOYMENT_REQUIREMENTS.md §7.2).
# No real secrets appear in this example — the "change-me" values below are
# placeholders and are REJECTED when NODE_ENV=production.

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
# Port the API listens on locally (the frontend dev server proxies /api here).
PORT=4000
# Canonical public URL of the site; used for CORS and in email links.
APP_URL=http://localhost:5173
# Comma-separated CORS origin allowlist. Defaults to APP_URL when unset.
CORS_ORIGINS=http://localhost:5173
# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Database ---------------------------------------------------------------
# Option A: a single connection URL (used by the db:* scripts and the API).
# DATABASE_URL=mysql://bodhisattva:change-me-db-password@localhost:3306/bodhisattva_dev
# Option B: discrete variables (used when DATABASE_URL is unset).
DB_HOST=localhost
DB_PORT=3306
# Per-worker connection pool limit (Passenger may run several workers;
# aggregate = workers x this value — keep conservative on shared hosting)
DB_POOL_LIMIT=5
DB_NAME=bodhisattva_dev
DB_USER=bodhisattva
DB_PASSWORD=change-me-db-password

# --- Secrets (generate unique values per environment; min 32 chars) ---------
# Signing/encryption material for session identifiers.
SESSION_SECRET=change-me-session-secret-0000000000000000
# HMAC key protecting stored email verification codes. Separate from SESSION_SECRET.
OTP_HMAC_SECRET=change-me-otp-hmac-secret-00000000000000000
# Key encrypting stored TOTP MFA secrets at rest. Separate from all other
# secrets; if it is lost, every admin must re-enrol MFA — back it up with the
# configuration backup, never in the repo.
TOTP_ENCRYPTION_KEY=change-me-totp-encryption-key-000000000000

# --- Email (SMTP) -------------------------------------------------------------
# Local development: run a mail catcher (e.g. Mailpit) on localhost:1025.
# Production provider/host is a pending decision (blocking decision B2).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Bodhisattva Museum <no-reply@localhost>

# --- Storage ------------------------------------------------------------------
# Root of private storage (media, product images, invoice PDFs, backups).
# Always outside public_html in production (ARCHITECTURE.md §9).
UPLOAD_DIRECTORY=../private-storage

# --- OTP policy (spec Part 7.1; server-configuration only) --------------------
OTP_POLICY_EXPIRY_SECONDS=600
OTP_POLICY_MAX_ATTEMPTS=5
OTP_POLICY_RESEND_COOLDOWN_SECONDS=60
OTP_POLICY_MAX_SENDS_PER_HOUR=3

# --- Rate-limit policy (spec §15.3; server-configuration only) -----------------
RATE_LIMIT_LOGIN_MAX_FAILURES=5
RATE_LIMIT_LOGIN_WINDOW_MINUTES=15
RATE_LIMIT_ADMIN_LOGIN_MAX_FAILURES=3
RATE_LIMIT_REGISTRATION_PER_HOUR=3
RATE_LIMIT_RECOVERY_PER_HOUR=3
